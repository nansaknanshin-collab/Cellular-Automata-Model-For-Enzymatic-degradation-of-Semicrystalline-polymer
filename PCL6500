    print(f"Parameter values:     {param_path}")
    print(f"Excel curve data:     {excel_path}")
    print(f"Weight-loss figure:   {wl_fig_path}")
    print(f"Crystallinity figure: {xc_fig_path}")

    return summary_df, param_df, curve_df


