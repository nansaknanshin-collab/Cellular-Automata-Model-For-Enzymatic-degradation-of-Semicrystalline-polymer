        OUTPUT_DIR,
        f"{SELECTED_POLYMER}_{model_label}_weight_loss_{timestamp}.png"
    )
    xc_fig_path = os.path.join(
        OUTPUT_DIR,
        f"{SELECTED_POLYMER}_{model_label}_crystallinity_{timestamp}.png"
    )

    fig_wl, ax = plt.subplots(figsize=(8, 5.5))
