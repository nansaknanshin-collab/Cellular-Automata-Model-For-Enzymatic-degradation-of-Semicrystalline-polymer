    fig_xc, ax = plt.subplots(figsize=(8, 5.5))
    ax.plot(data["t_xc"], 100.0 * data["xc_obs"], "ks", ms=10, label=f"{SELECTED_POLYMER} Data")
    ax.plot(t_smooth, xc_smooth, "b-", lw=5, label="CA Model Fit")
    ax.set_xlabel("Time (h)", fontsize=18)
    ax.set_ylabel("Remaining crystallinity (%)", fontsize=18)
    ax.tick_params(axis="both", labelsize=16)
    ax.xaxis.set_major_locator(MaxNLocator(integer=True))
    ax.yaxis.set_major_locator(MaxNLocator(integer=True))
    ax.grid(alpha=0.3)
    ax.legend(fontsize=12, frameon=True)
    plt.tight_layout()
    plt.savefig(xc_fig_path, dpi=600, bbox_inches="tight")
