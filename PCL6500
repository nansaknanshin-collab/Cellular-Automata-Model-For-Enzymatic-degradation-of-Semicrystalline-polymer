# ============================================================
# 2) POROSITY-DEPENDENT DIFFUSIVITY
# ============================================================
def compute_porosity_field(phase, window):
    void_only = (phase == S_VOID).astype(float)
    ny, nx = phase.shape
    phi = np.zeros_like(void_only, dtype=float)

    pad = max(int(window), 1)
    padded_void = np.pad(
        void_only,
        pad_width=pad,
        mode="constant",
        constant_values=1.0
    )

    w = 2 * pad + 1

    for dj in range(-pad, pad + 1):
        for di in range(-pad, pad + 1):
            phi += padded_void[
                pad + dj:pad + dj + ny,
                pad + di:pad + di + nx
            ]

    phi /= float(w * w)
    return phi


def effective_diffusivity(phi, D_E0, alpha):
    """
    Porosity-enhanced enzyme diffusivity:
        D_E(phi) = D_E0 * (1 + alpha * phi)

    alpha is calibrated. phi is computed directly from the CA lattice as the local void fraction.
    """
    return D_E0 * (1.0 + alpha * phi)


# ============================================================
# 3) SAME-GRID FOUR-SIDED DIFFUSION PDE
# ============================================================
def build_diffusion_matrix(D_field, dt, dx, bath_value):
    ny, nx = D_field.shape

    n_solve_rows = ny - 2
    n_solve_cols = nx - 2

    if n_solve_rows <= 0 or n_solve_cols <= 0:
        raise ValueError("ROWS and COLS must both be at least 3.")

    N = n_solve_rows * n_solve_cols

    def idx(j, i):
        return (j - 1) * n_solve_cols + (i - 1)

    rows, cols, vals = [], [], []
    rhs_extra = np.zeros(N)

    for j in range(1, ny - 1):
        for i in range(1, nx - 1):
            k = idx(j, i)
            diag_val = 1.0

            for dj, di in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                jj, ii = j + dj, i + di

                D_face = 0.5 * (D_field[j, i] + D_field[jj, ii])
                coef = dt * D_face / dx**2

                if jj == 0 or jj == ny - 1 or ii == 0 or ii == nx - 1:
                    rhs_extra[k] += coef * bath_value
                else:
                    rows.append(k)
                    cols.append(idx(jj, ii))
                    vals.append(-coef)

                diag_val += coef

            rows.append(k)
            cols.append(k)
            vals.append(diag_val)

    A = csr_matrix((vals, (rows, cols)), shape=(N, N))
    return A, rhs_extra


def diffuse_field(field, phase, D_E0, alpha, dt, dx, bath_value):
    ny, nx = field.shape

    phi = compute_porosity_field(phase, window=PHI_WINDOW)
    D_field = effective_diffusivity(phi, D_E0, alpha)

    A, rhs_extra = build_diffusion_matrix(
        D_field,
        dt,
        dx,
        bath_value=bath_value
    )

    rhs = field[1:-1, 1:-1].flatten() + rhs_extra
    internal_new = spsolve(A, rhs).reshape(ny - 2, nx - 2)

    out = field.copy()
    out[0, :] = bath_value
    out[-1, :] = bath_value
    out[:, 0] = bath_value
    out[:, -1] = bath_value
    out[1:-1, 1:-1] = internal_new

    np.clip(out, 0.0, None, out=out)
    return out


def diffuse_E(E_field, phase, D_E0, alpha, dt, dx):
    return diffuse_field(
        E_field,
        phase,
        D_E0,
        alpha,
        dt,
        dx,
        E_BATH
    )


# ============================================================
# 3a) POLYDISPERSE INITIAL CHAIN LENGTH SAMPLING
# Sevim-style per-cell sampling: each cell gets one chain whose length is
# drawn from a lognormal distribution with mean = MN0/M0_REPEAT and
# Mw/Mn = PDI from GPC measurement. PDI is an experimental input.
# ============================================================
def sample_initial_chain_lengths(rng, ny, nx, target_mean_N, PDI, cap_multiple):
    """
    Lognormal per-cell initial chain length, parameterised so that
        E[N]        = target_mean_N
        Mw/Mn of N  = PDI
    For a lognormal on N, Mw/Mn = exp(sigma_ln**2), giving
        sigma_ln = sqrt(log(PDI))
        mu_ln    = log(target_mean_N) - 0.5 * sigma_ln**2

    The tail is truncated at cap_multiple * target_mean_N to bound Nk memory.
    A floor of 2 ensures every cell has at least one scissile bond.
    """
    sigma_ln = np.sqrt(np.log(PDI))
    mu_ln = np.log(target_mean_N) - 0.5 * sigma_ln**2

    N_samples = rng.lognormal(mean=mu_ln, sigma=sigma_ln, size=(ny, nx))
    N_cap = cap_multiple * target_mean_N
    N_samples = np.clip(np.round(N_samples), 2, N_cap).astype(int)

    return N_samples


# ============================================================
# 4) MOLECULAR WEIGHT + CHAIN TRACKING
# ============================================================
def recalc_Mn_from_Nk_cell(Nk_cell):
    k_vals = np.arange(Nk_cell.size, dtype=float)
    total_units = np.sum(k_vals * Nk_cell)
    total_chains = np.sum(Nk_cell)

    if total_chains <= 0 or total_units <= 0:
        return 0.0

    return M0_REPEAT * total_units / total_chains


def perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng):
    Nk_cell = Nk[j, i, :]

    available = np.where(Nk_cell > 0)[0]
    available = available[available >= 2]

    if available.size == 0:
        return False

    weights = Nk_cell[available].astype(float)
    weights /= np.sum(weights)

    k_old = int(rng.choice(available, p=weights))
    r = int(rng.integers(1, k_old))

    Nk[j, i, k_old] -= 1
    Nk[j, i, r] += 1
    Nk[j, i, k_old - r] += 1

    Mn_field[j, i] = recalc_Mn_from_Nk_cell(Nk[j, i, :])
    return True


def update_Mn_after_scission_only(Nk, Mn_field, j, i):
    """
    Simplified 9-parameter model.

    Soluble oligomer diffusion is not modelled explicitly.
    Chain scission only changes the local chain-length distribution and Mn.
    Mass loss occurs only when a degraded cell erodes after satisfying
    the molecular-weight threshold criterion.
    """
    Mn_field[j, i] = recalc_Mn_from_Nk_cell(Nk[j, i, :])
    return None



# ============================================================
# 5) VON NEUMANN ENZYME NEIGHBOURHOOD FOR EROSION
# ============================================================
def von_neumann_enzyme_sum(E_field):
    Esum = np.zeros_like(E_field, dtype=float)

    Esum[1:, :] += E_field[:-1, :]
    Esum[:-1, :] += E_field[1:, :]
    Esum[:, 1:] += E_field[:, :-1]
    Esum[:, :-1] += E_field[:, 1:]

    Esum[0, :] += E_BATH
    Esum[-1, :] += E_BATH
    Esum[:, 0] += E_BATH
    Esum[:, -1] += E_BATH

    return Esum


def boundary_contact_mask(shape):
    """
    True for cells directly in contact with the external enzyme bath.
    These are the physical film boundary cells.
    """
    ny, nx = shape
    mask = np.zeros((ny, nx), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    mask[:, -1] = True
    return mask


def update_voids_from_Mnc_and_von_neumann_enzyme(
    phase,
    Mn_field,
    Nk,
    deg_origin,
    mass_field,
    Mnc,
    E_field,
    k_det,
    beta_phi,
    rng,
    dt
):
    E_neigh_sum = von_neumann_enzyme_sum(E_field)
    has_E_neigh = E_neigh_sum > ENZYME_NEIGHBOUR_THRESHOLD

    boundary_contact = boundary_contact_mask(phase.shape)

    # Boundary degraded cells do NOT have to wait until Mn <= Mnc.
    # They become eligible immediately after degradation because they are
    # directly exposed to the external enzyme medium.
    #
    # Interior degraded cells still require Mn <= Mnc.
    eligible = (
        (phase == S_DEG)
        &
        (
            boundary_contact
            | (Mn_field <= Mnc)
        )
        &
        has_E_neigh
    )

    # ========================================================
    # POROSITY-DEPENDENT EROSION / DETACHMENT
    # --------------------------------------------------------
    # Local pores increase enzyme accessibility and reduce
    # mechanical support, so degraded cells near pores detach faster:
    #
    #     k_det_eff(i,j,t) = k_det * (1 + beta_phi * phi(i,j,t))
    #
    # where phi is the local void fraction computed on the CA lattice.
    # ========================================================
    phi = compute_porosity_field(phase, window=PHI_WINDOW)
    k_det_eff = k_det * (1.0 + beta_phi * phi)

    E_neigh_mean = E_neigh_sum / 4.0
    P_void = 1.0 - np.exp(-k_det_eff * E_neigh_mean * dt)
    P_void = np.clip(P_void, 0.0, 1.0)

    erode = eligible & (rng.random(phase.shape) < P_void)

    phase[erode] = S_VOID
    Mn_field[erode] = 0.0
    mass_field[erode] = 0.0
    Nk[erode, :] = 0
    deg_origin[erode] = ORIGIN_NONE

# ============================================================
# 6) CA REACTION STEP
# ============================================================
def reaction_step(
    phase,
    bound,
    E_field,
    Mn_field,
    mass_field,
    Nk,
    deg_origin,
    params,
    beta_phi,
    rng,
    dt,
):
    k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det = params

    ny, nx = phase.shape

    phase_old = phase.copy()
    bound_old = bound.copy()
    E_old = E_field.copy()
    origin_old = deg_origin.copy()

    dE_quantum = E_BATH / max(ny * nx // 100, 1)

    U1 = rng.random((ny, nx))
    U2 = rng.random((ny, nx))

    for j in range(ny):
        for i in range(nx):
            s = phase_old[j, i]
            b = bound_old[j, i]
            E_loc = E_old[j, i]

            if s == S_VOID:
                continue

            u1 = U1[j, i]
            u2 = U2[j, i]

            if s == S_DEG:
                origin = origin_old[j, i]

                if origin == ORIGIN_C:
                    rate = k_deg_C * E_loc
                elif origin == ORIGIN_A:
                    rate = k_deg_A * E_loc
                else:
                    rate = 0.0

                P = 1.0 - np.exp(-rate * dt)

                if u1 < P:
                    perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng)
                    update_Mn_after_scission_only(Nk, Mn_field, j, i)

                continue

            if s == S_CRYST:
                if not b:
                    rate = k1 * E_loc
                    P = 1.0 - np.exp(-rate * dt)

                    if u1 < P and E_loc > dE_quantum:
                        bound[j, i] = True
                        E_field[j, i] -= dE_quantum

                else:
                    rates = np.array([k_conv, k_deg_C], dtype=float)
                    r_tot = np.sum(rates)

                    if r_tot > 0:
                        P = 1.0 - np.exp(-r_tot * dt)

                        if u1 < P:
                            cum = np.cumsum(rates) / r_tot

                            if u2 < cum[0]:
                                phase[j, i] = S_AMORPH
                            else:
                                phase[j, i] = S_DEG
                                deg_origin[j, i] = ORIGIN_C
                                perform_chain_scission_full_Nk(
                                    Nk,
                                    Mn_field,
                                    j,
                                    i,
                                    rng
                                )
                                update_Mn_after_scission_only(Nk, Mn_field, j, i)

                            bound[j, i] = False
                            E_field[j, i] += dE_quantum

                continue

            if s == S_AMORPH:
                if not b:
                    rate = k3 * E_loc
                    P = 1.0 - np.exp(-rate * dt)

                    if u1 < P and E_loc > dE_quantum:
                        bound[j, i] = True
                        E_field[j, i] -= dE_quantum

                else:
                    rate = k_deg_A
                    P = 1.0 - np.exp(-rate * dt)

                    if u1 < P:
                        phase[j, i] = S_DEG
                        deg_origin[j, i] = ORIGIN_A
                        perform_chain_scission_full_Nk(
                            Nk,
                            Mn_field,
                            j,
                            i,
                            rng
                        )
                        update_Mn_after_scission_only(Nk, Mn_field, j, i)

                        bound[j, i] = False
                        E_field[j, i] += dE_quantum

                continue

    update_voids_from_Mnc_and_von_neumann_enzyme(
        phase=phase,
        Mn_field=Mn_field,
        Nk=Nk,
        deg_origin=deg_origin,
        mass_field=mass_field,
        Mnc=Mnc,
        E_field=E_field,
        k_det=k_det,
        beta_phi=beta_phi,
        rng=rng,
        dt=dt
    )

    E_field[0, :] = E_BATH
    E_field[-1, :] = E_BATH
    E_field[:, 0] = E_BATH
    E_field[:, -1] = E_BATH

    np.clip(E_field, 0.0, None, out=E_field)


# ============================================================
# 7) HYBRID CA/PDE SIMULATION DRIVER FOR ONE POLYMER
# ============================================================
def run_hybrid_one_polymer(
    params_kinetic,
    D_E0,
    alpha,
    beta_phi,
    MW0,
    chi,
    t_end,
    seed,
    record_times=None,
    PDI=None,
    verbose_init=False,
):
    rng = np.random.default_rng(seed)

    ny, nx = ROWS, COLS

    target_mean_N = MW0 / M0_REPEAT

    if PDI is None:
        PDI = PDI_BY_GRADE[SELECTED_POLYMER]

    # --------- POLYDISPERSE INITIAL CHAIN LENGTHS ---------
    # Each cell gets one chain of length N0_per_cell[j, i], drawn from a
    # lognormal with mean target_mean_N and Mw/Mn = PDI.
    N0_per_cell = sample_initial_chain_lengths(
        rng, ny, nx, target_mean_N, PDI, N0_CAP_MULTIPLE
    )

    M_MAX = int(N0_per_cell.max())

    # Nk built by vectorised indexing: Nk[j, i, N0_per_cell[j, i]] = 1.
    Nk = np.zeros((ny, nx, M_MAX + 1), dtype=np.int16)
    js, is_ = np.meshgrid(np.arange(ny), np.arange(nx), indexing="ij")
    Nk[js, is_, N0_per_cell] = 1

    # Mn per cell = M0_REPEAT * (chain length in this cell).
    Mn_field = M0_REPEAT * N0_per_cell.astype(float)

    # ----- ABSOLUTE-UNIT MASS BOOKKEEPING -----
    # mass_field[j, i] = repeat units of solid polymer remaining in cell.
    # With polydispersity, cells start with DIFFERENT amounts of mass
    # (their N0 values), so mass must be tracked in absolute units rather
    # than fractions of cell-specific initial mass. Total initial polymer
    # mass = sum(N0_per_cell) repeat units, captured below for WL metric.
    mass_field = N0_per_cell.astype(float).copy()

    total_initial_units = float(np.sum(N0_per_cell))

    if verbose_init:
        realised_mean_N = N0_per_cell.mean()
        realised_PDI = float(np.exp(np.var(np.log(N0_per_cell.astype(float)))))
        print(f"  PDI init: target Mn = {MW0:.0f}, "
              f"realised Mn = {M0_REPEAT * realised_mean_N:.0f}")
        print(f"  PDI init: target PDI = {PDI:.3f}, "
              f"realised PDI = {realised_PDI:.3f}")
        print(f"  PDI init: M_MAX = {int(N0_per_cell.max())} repeat units, "
              f"min N = {int(N0_per_cell.min())}")

    phase = rng.choice(
        [S_AMORPH, S_CRYST],
        size=(ny, nx),
        p=[1.0 - chi, chi]
    ).astype(int)

    bound = np.zeros((ny, nx), dtype=bool)
    deg_origin = np.full((ny, nx), ORIGIN_NONE, dtype=int)

    E_field = np.zeros((ny, nx), dtype=float)
    E_field[0, :] = E_BATH
    E_field[-1, :] = E_BATH
    E_field[:, 0] = E_BATH
    E_field[:, -1] = E_BATH

    if record_times is None:
        record_times = np.linspace(0, t_end, 51)

    record_times = np.asarray(record_times, dtype=float)

    t_record = []
    wl_record = []
    xc_record = []
    mn_record = []

    def metrics():
        """
        Corrected observables for the present PCL-CALB data scale.

        WL is the fraction of the original polymer mass removed.

        Xc is computed as the crystalline mass fraction among the remaining
        non-eroded polymer mass:
            Xc = massC / (massA + massC + massD).

        S_DEG cells are included because degraded cells remain in the polymer
        until erosion converts them to S_VOID. S_VOID cells are excluded because
        they have already been removed.
        """
        massC = float(np.sum(mass_field[phase == S_CRYST]))
        massA = float(np.sum(mass_field[phase == S_AMORPH]))
        massD = float(np.sum(mass_field[phase == S_DEG]))

        total_remaining = massC + massA + massD

        wl = 1.0 - total_remaining / total_initial_units
        wl = float(np.clip(wl, 0.0, 1.0))

        # Mass-based crystallinity, consistent with DSC-style crystallinity.
        # Degraded-but-not-eroded cells are still part of the remaining polymer.
        denom_xc = massC + massA + massD
        xc = massC / denom_xc if denom_xc > 0 else 0.0
        xc = float(np.clip(xc, 0.0, 1.0))

        mn_global = recalc_Mn_from_Nk_cell(np.sum(Nk, axis=(0, 1)))

        return wl, xc, mn_global

    t = 0.0

    wl0, xc0, mn0 = metrics()

    t_record.append(0.0)
    wl_record.append(wl0)
    xc_record.append(xc0)
    mn_record.append(mn0)

    next_record_idx = 1

    while t < t_end - 1e-12:
        E_field = diffuse_E(
            E_field,
            phase,
            D_E0,
            alpha,
            DT,
            DX
        )

        reaction_step(
            phase=phase,
            bound=bound,
            E_field=E_field,
            Mn_field=Mn_field,
            mass_field=mass_field,
            Nk=Nk,
            deg_origin=deg_origin,
            params=params_kinetic,
            beta_phi=beta_phi,
            rng=rng,
            dt=DT,
        )

        t += DT

        while (
            next_record_idx < len(record_times)
            and record_times[next_record_idx] <= t + 1e-12
        ):
            wl, xc, mn_global = metrics()

            t_record.append(record_times[next_record_idx])
            wl_record.append(wl)
            xc_record.append(xc)
            mn_record.append(mn_global)

            next_record_idx += 1

    return (
        np.array(t_record),
        np.array(wl_record),
        np.array(xc_record),
        np.array(mn_record)
    )


# ============================================================
# 8) PARAMETER UNPACKING + ONE-POLYMER SIMULATION
# ============================================================
def unpack_theta(theta):
    theta = np.asarray(theta, dtype=float)

    # Calibrated parameter vector:
    # [k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det, D_E0, alpha, beta_phi]
    params_kinetic = tuple(theta[:7])
    D_E0 = float(theta[7])
    alpha = float(theta[8])
    beta_phi = float(theta[9])

    return (
        params_kinetic,
        D_E0,
        alpha,
        beta_phi
    )


def simulate_polymer_predictions(poly_name, theta, seeds=SEEDS, record_times=None):
    data = POLYMER_DATA[poly_name]
    PDI = PDI_BY_GRADE[poly_name]

    (
        params_kinetic,
        D_E0,
        alpha,
        beta_phi
    ) = unpack_theta(theta)

    if record_times is None:
        record_times = np.unique(
            np.concatenate([data["t_wl"], data["t_xc"]])
        )

    t_end = float(np.max(record_times))

    wl_runs = []
    xc_runs = []

    for sd in seeds:
        t_sim, wl_sim, xc_sim, _ = run_hybrid_one_polymer(
            params_kinetic=params_kinetic,
            D_E0=D_E0,
            alpha=alpha,
            beta_phi=beta_phi,
            MW0=data["MN0"],
            chi=data["X_FIXED"],
            t_end=t_end,
            seed=int(sd),
            record_times=record_times,
            PDI=PDI,
        )

        wl_runs.append(np.interp(data["t_wl"], t_sim, wl_sim))
        xc_runs.append(np.interp(data["t_xc"], t_sim, xc_sim))

    return {
        "wl": np.mean(np.asarray(wl_runs), axis=0),
        "xc": np.mean(np.asarray(xc_runs), axis=0),
    }


# ============================================================
# 9) NORMAL JOINT LEAST-SQUARES COST FOR ONE GRADE
# ============================================================
def joint_ls_cost(theta):
    theta = np.asarray(theta, dtype=float)

    if np.any(theta <= 0):
        return 1e12

    (
        params_kinetic,
        D_E0,
        alpha,
        beta_phi
    ) = unpack_theta(theta)

    k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det = params_kinetic

    if k_deg_A <= k_deg_C:
        return 1e12

    if k3 <= k1:
        return 1e12

    if not (0.0 <= Mnc <= 25000.0):
        return 1e12

    if not (1.0 <= alpha <= 100.0):
        return 1e12

    if not (1.0 <= beta_phi <= 100.0):
        return 1e12

    residuals = []

    try:
        for poly_name, data in POLYMER_DATA.items():
            pred = simulate_polymer_predictions(poly_name, theta)

            # Ordinary unweighted residuals.
            # No error bars.
            # No sigma scaling.
            # No weighted least squares.
            residuals.extend(pred["wl"] - data["wl_obs"])
            residuals.extend(pred["xc"] - data["xc_obs"])

        residuals = np.asarray(residuals, dtype=float)

        cost = np.sum(residuals**2)

    except Exception:
        return 1e12

    if not np.isfinite(cost):
        return 1e12

    return float(cost)


def pso_objective(swarm):
    return np.array(
        [joint_ls_cost(theta) for theta in swarm],
        dtype=float
    )


# ============================================================
# 10) PSO + SLSQP CALIBRATION
# ============================================================
def calibrate_pso_ls(n_particles=25, iters=15, local_refine=True):
    # Calibrated parameter vector:
    # [k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det, D_E0, alpha, beta_phi]

    lo = np.array([
        1e-6,      # k1
        1e-6,      # k3
        1e-8,      # k_conv
        1e-6,      # k_deg_C
        1e-6,      # k_deg_A
        1e-6,      # Mnc
        1e-6,      # k_det
        1e-6,      # D_E0
        1e-6,       # alpha
        1e-6,       # beta_phi
    ])

    hi = np.array([
        2.0,       # k1
        8.0,       # k3
        1.0,       # k_conv
        1.0,       # k_deg_C
        3.0,       # k_deg_A
        25000.0,   # Mnc
        5.0,       # k_det
        50.0,      # D_E0
        100,    # alpha
        100,    # beta_phi
    ])

    np.random.seed(SEED)

    optimizer = GlobalBestPSO(
        n_particles=n_particles,
        dimensions=10,
        bounds=(lo, hi),
        options={"c1": 1.7, "c2": 1.7, "w": 0.6}
    )

    best_cost, best_theta = optimizer.optimize(
        pso_objective,
        iters=iters,
        verbose=True
    )

    theta_final = best_theta
    final_cost = best_cost

    if local_refine:
        res = minimize(
            joint_ls_cost,
            best_theta,
            method="SLSQP",
            bounds=list(zip(lo, hi)),
            options={
                "maxiter": 120,
                "ftol": 1e-8,
                "disp": True
            }
        )

        theta_final = res.x
        final_cost = res.fun

    names = [
        "k1",
        "k3",
        "k_conv",
        "k_deg_C",
        "k_deg_A",
        "Mnc",
        "k_det",
        "D_E0",
        "alpha",
        "beta_phi"
    ]

    print("\n================ FINAL PARAMETERS ================")

    for name, value in zip(names, theta_final):
        if name == "Mnc":
            print(f"{name:22s} = {value:.6e} g/mol")
        else:
            print(f"{name:22s} = {value:.6e}")

    # alpha and beta_phi are calibrated and printed above.
    print(f"{'PHI_WINDOW':22s} = {PHI_WINDOW:d}")
    print(f"{'PDI':22s} = {PDI_BY_GRADE[SELECTED_POLYMER]:.3f}  (Ma et al. 2020, input)")
    print(f"{'N0_CAP_MULTIPLE':22s} = {N0_CAP_MULTIPLE:.2f}")
    print(f"Final ordinary joint least-squares cost = {final_cost:.6e}")

    return theta_final, final_cost

# ============================================================
# 12) FIT QUALITY + AIC/AICc/BIC MODEL SELECTION
# ============================================================
def r2_score(y_true, y_pred):
    y_true = np.asarray(y_true, float)
    y_pred = np.asarray(y_pred, float)

    ss_res = np.sum((y_true - y_pred) ** 2)
    ss_tot = np.sum((y_true - np.mean(y_true)) ** 2)

    return np.nan if ss_tot == 0 else 1.0 - ss_res / ss_tot


def rmse_pp(y_true, y_pred):
    y_true = np.asarray(y_true, float)
    y_pred = np.asarray(y_pred, float)
    return 100.0 * float(np.sqrt(np.mean((y_true - y_pred) ** 2)))


def mean_bias_pp(y_true, y_pred):
    y_true = np.asarray(y_true, float)
    y_pred = np.asarray(y_pred, float)
    return 100.0 * float(np.mean(y_pred - y_true))


def compute_information_criteria(rss, k, n):
    """
    Ordinary least-squares AIC, AICc and BIC.

    rss = residual sum of squares from the same objective used in calibration.
    k   = number of fitted parameters.
    n   = number of fitted observations.
    """
    rss = float(rss)
    k = int(k)
    n = int(n)

    if rss <= 0.0:
        rss = 1e-300

    aic = n * np.log(rss / n) + 2.0 * k
    bic = n * np.log(rss / n) + k * np.log(n)

    if n - k - 1 > 0:
        aicc = aic + (2.0 * k * (k + 1.0)) / (n - k - 1.0)
    else:
        aicc = np.nan

    return aic, aicc, bic


def count_observations():
    """Counts WL + Xc data points used in the objective."""
    n = 0
    for _, data in POLYMER_DATA.items():
        n += len(data["wl_obs"])
        n += len(data["xc_obs"])
    return int(n)


def get_parameter_names(k):
    if k == 10:
        return [
            "k1", "k3", "k_conv", "k_deg_C", "k_deg_A",
            "Mnc", "k_det", "D_E0", "alpha", "beta_phi"
        ]
    return [f"theta_{i+1}" for i in range(k)]


def get_model_label(k):
    if k == 10:
        return "10param_new_logic_no_oligomer_PDE"
    return f"{k}param_model"


def save_model_outputs(theta_opt, final_cost):
    data = POLYMER_DATA[SELECTED_POLYMER]
    pred = simulate_polymer_predictions(SELECTED_POLYMER, theta_opt)

    r2_wl = r2_score(data["wl_obs"], pred["wl"])
    r2_xc = r2_score(data["xc_obs"], pred["xc"])

    rmse_wl = rmse_pp(data["wl_obs"], pred["wl"])
    rmse_xc = rmse_pp(data["xc_obs"], pred["xc"])

    bias_wl = mean_bias_pp(data["wl_obs"], pred["wl"])
    bias_xc = mean_bias_pp(data["xc_obs"], pred["xc"])

    n = count_observations()
    k = len(theta_opt)
    rss = float(final_cost)
    aic, aicc, bic = compute_information_criteria(rss=rss, k=k, n=n)

    model_label = get_model_label(k)
    names = get_parameter_names(k)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

    print(f"\n================ {SELECTED_POLYMER} FIT QUALITY ================")
    print(f"Model type       = {model_label}")
    print(f"R² WL            = {r2_wl:.6f}")
    print(f"R² Xc            = {r2_xc:.6f}")
    print(f"RMSE WL          = {rmse_wl:.6f} percentage points")
    print(f"RMSE Xc          = {rmse_xc:.6f} percentage points")
    print(f"Bias WL          = {bias_wl:+.6f} percentage points")
    print(f"Bias Xc          = {bias_xc:+.6f} percentage points")
    print(f"RSS/final cost   = {rss:.10e}")

    print("\n================ AIC / AICc / BIC ================")
    print(f"Number of observations, n       = {n}")
    print(f"Number of fitted parameters, k  = {k}")
    print(f"AIC                             = {aic:.6f}")
    print(f"AICc                            = {aicc:.6f}")
    print(f"BIC                             = {bic:.6f}")

    summary_df = pd.DataFrame([{
        "polymer": SELECTED_POLYMER,
        "model_label": model_label,
        "n_observations": n,
        "k_parameters": k,
        "RSS": rss,
        "AIC": aic,
        "AICc": aicc,
        "BIC": bic,
        "R2_WL": r2_wl,
        "R2_Xc": r2_xc,
        "RMSE_WL_pp": rmse_wl,
        "RMSE_Xc_pp": rmse_xc,
        "Bias_WL_pp": bias_wl,
        "Bias_Xc_pp": bias_xc,
    }])

    param_df = pd.DataFrame({
        "parameter": names,
        "value": np.asarray(theta_opt, dtype=float)
    })

    curve_df = pd.DataFrame({
        "time_WL_h": data["t_wl"],
        "WL_observed_percent": 100.0 * data["wl_obs"],
        "WL_fitted_percent": 100.0 * pred["wl"],
        "time_Xc_h": data["t_xc"],
        "Xc_observed_percent": 100.0 * data["xc_obs"],
        "Xc_fitted_percent": 100.0 * pred["xc"],
    })

    summary_path = os.path.join(
        OUTPUT_DIR,
        f"{SELECTED_POLYMER}_{model_label}_AIC_AICc_BIC_{timestamp}.csv"
    )
    param_path = os.path.join(
        OUTPUT_DIR,
        f"{SELECTED_POLYMER}_{model_label}_parameters_{timestamp}.csv"
    )
    excel_path = os.path.join(
        OUTPUT_DIR,
        f"{SELECTED_POLYMER}_{model_label}_curve_and_AIC_BIC_{timestamp}.xlsx"
    )

    summary_df.to_csv(summary_path, index=False)
    param_df.to_csv(param_path, index=False)

    with pd.ExcelWriter(excel_path, engine="openpyxl") as writer:
        curve_df.to_excel(writer, sheet_name="curve_data", index=False)
        summary_df.to_excel(writer, sheet_name="AIC_BIC_summary", index=False)
        param_df.to_excel(writer, sheet_name="parameters", index=False)

    # Smooth visual curves only for plotting; AIC/BIC uses final_cost/RSS above.
    t_smooth = np.linspace(
        min(data["t_wl"].min(), data["t_xc"].min()),
