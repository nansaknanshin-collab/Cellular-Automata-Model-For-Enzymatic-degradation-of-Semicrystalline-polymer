function [predWL, predXC] = compute_predictions_CA(samples, data, C, tgrid)
ns = size(samples,1);
nt = numel(tgrid);
predWL = zeros(ns,nt);
predXC = zeros(ns,nt);
for i = 1:ns
    params = unpack_theta(samples(i,:));
    [tSim, wlSim, xcSim, ~] = run_hybrid_one_polymer(params, data.MN0, data.X_FIXED, max(tgrid), C.FIXED_LIK_SEED, tgrid, C);
    predWL(i,:) = interp1(tSim, wlSim, tgrid, 'linear', 'extrap');
    predXC(i,:) = interp1(tSim, xcSim, tgrid, 'linear', 'extrap');
    if mod(i,max(1,floor(ns/10))) == 0
        fprintf('Prediction runs: %d/%d\n', i, ns);
    end
end
end

function Q95 = compute_Q95_CA_WL(samples, bestParams, data, C, time)
paramsBest = unpack_theta(bestParams);
[~, WLbest, ~, ~] = run_hybrid_one_polymer(paramsBest, data.MN0, data.X_FIXED, max(time), C.FIXED_LIK_SEED, time, C);
Q = nan(size(samples,1),1);
for i = 1:size(samples,1)
    params = unpack_theta(samples(i,:));
    [~, WLi, ~, ~] = run_hybrid_one_polymer(params, data.MN0, data.X_FIXED, max(time), C.FIXED_LIK_SEED, time, C);
    valid = (WLi > 1e-8) & (WLbest > 1e-8);
    if any(valid)
        ld = log2(WLi(valid) ./ WLbest(valid));
        Q(i) = sum(ld.^2);
    end
end
Q = Q(isfinite(Q));
if isempty(Q); Q95 = NaN; else; Q95 = prctile(Q,95); end
end

function Q95 = compute_Q95_CA_XC(samples, bestParams, data, C, time)
paramsBest = unpack_theta(bestParams);
[~, ~, XCbest, ~] = run_hybrid_one_polymer(paramsBest, data.MN0, data.X_FIXED, max(time), C.FIXED_LIK_SEED, time, C);
Q = nan(size(samples,1),1);
for i = 1:size(samples,1)
    params = unpack_theta(samples(i,:));
    [~, ~, XCi, ~] = run_hybrid_one_polymer(params, data.MN0, data.X_FIXED, max(time), C.FIXED_LIK_SEED, time, C);
    valid = (XCi > 1e-8) & (XCbest > 1e-8);
    if any(valid)
        ld = log2(XCi(valid) ./ XCbest(valid));
        Q(i) = sum(ld.^2);
    end
end
Q = Q(isfinite(Q));
if isempty(Q); Q95 = NaN; else; Q95 = prctile(Q,95); end
end

% ============================================================
% DEMCz CORE
% ============================================================
function [saved_states, saved_logprob] = DEMCz(logtarget, states, Z, n, n_thin, blockindex, current_logprob, temperature_schedule, gamma_schedule, jitter)
[m,d] = size(states);
mZ0 = size(Z,1);
if nargin < 10 || isempty(jitter); jitter = 1e-5 .* ones(1,d); end
if nargin < 9 || isempty(gamma_schedule)
    gamma_schedule = zeros(numel(blockindex),1);
    for k = 1:numel(blockindex)
        gamma_schedule(k) = 2.38 / sqrt(2 * numel(blockindex{k}));
    end
end
if isvector(gamma_schedule); gamma_schedule = gamma_schedule(:); end
if nargin < 8 || isempty(temperature_schedule); temperature_schedule = []; end
if nargin < 7 || isempty(current_logprob)
    current_logprob = zeros(m,1);
    for j = 1:m
        current_logprob(j) = logtarget(states(j,:));
    end
end
if nargin < 6 || isempty(blockindex); blockindex = {1:d}; end
if nargin < 5 || isempty(n_thin); n_thin = 1; end

temperature_schedule = temperature_schedule(:);
if numel(temperature_schedule) < n
    temperature_schedule = [temperature_schedule; ones(n-numel(temperature_schedule),1)];
end
gamidx = mod(0:(n-1), size(gamma_schedule,2)) + 1;
save_logprob = [];

for it = 1:n
    for j = 1:m
        for k = 1:numel(blockindex)
            idx = blockindex{k};
            mZ = size(Z,1) - m;
            if mZ < 2
                n1 = randi(size(Z,1));
                if size(Z,1) < 2
                    n2 = n1;
                else
                    n2 = randi(size(Z,1)-1);
                    if n2 >= n1; n2 = n2 + 1; end
                end
            else
                n1 = randi(mZ);
                n2 = randi(mZ-1);
                if n2 >= n1; n2 = n2 + 1; end
            end
            diff = zeros(1,d);
            gamma_k = gamma_schedule(k, gamidx(it));
            diff(idx) = gamma_k .* (Z(n1,idx) - Z(n2,idx)) + jitter(idx).*randn(1,numel(idx));
            proposal = states(j,:) + diff;
            prop_logp = logtarget(proposal);
            if isfinite(prop_logp) && (temperature_schedule(it) * log(rand) < (prop_logp - current_logprob(j)))
                states(j,:) = proposal;
                current_logprob(j) = prop_logp;
            end
        end
    end
    if mod(it,n_thin) == 0
        Z = [Z; states]; %#ok<AGROW>
        save_logprob = [save_logprob; current_logprob]; %#ok<AGROW>
    end
    if mod(it,max(1,floor(n/10))) == 0
        fprintf('DE-MCz iteration %d/%d, mean logp = %.6g\n', it, n, mean(current_logprob(isfinite(current_logprob))));
    end
end

if size(Z,1) > mZ0
    saved_states = Z((mZ0+1):end,:);
else
    saved_states = [];
end
saved_logprob = save_logprob;
end

% ============================================================
% PLOTS / SAVING
% ============================================================
function plot_parameter_CI_grouped(samples, paramLabels, FS)
% Grouped 95% CI panels.
% Fixed:
%   1) alpha and beta_phi are rendered as LaTeX symbols.
%   2) all CI rectangles use the same width.
%   3) the single Mnc rectangle is not visually oversized because the same
%      x-axis padding is used across panels.
%   4) legend uses patch(NaN,NaN,...) handles, which avoids MATLAB rectangle
%      legend errors.

samples = samples(all(isfinite(samples),2),:);
means = mean(samples, 1);
lower = prctile(samples, 2.5, 1);
upper = prctile(samples, 97.5, 1);

% Current 9-parameter no-amorphisation order:
% 1:k1  2:k3  3:k_deg_C  4:k_deg_A  5:Mnc
% 6:k_det  7:D_E0  8:alpha  9:beta_phi
groups = { [1 2], [3 4 6], [7 8 9], 5 };

groupXLabels = { ...
    'Rate parameters', ...
    'Rate parameters', ...
    'Transport/porosity parameters', ...
    'Critical molecular weight' ...
};

cmap = lines(9);

% Same rectangle width in every subplot.
rectWidth = 0.36;

% Same x-axis padding in every subplot.
% This prevents the single Mnc CI rectangle from looking too wide.
xPad = 0.75;

figure('Color','w','Position',[100 100 1500 920]);

for p = 1:4
    subplot(2,2,p);
    cla; hold on; box on; grid on;

    idx = groups{p};
    h_leg = gobjects(1,numel(idx));

    for ii = 1:numel(idx)
        k = idx(ii);

        rectangle('Position', ...
            [ii - rectWidth/2, lower(k), rectWidth, max(upper(k)-lower(k),0)], ...
            'FaceColor', cmap(k,:), ...
            'EdgeColor', cmap(k,:), ...
            'LineWidth', 1.2);

        plot([ii - rectWidth/2, ii + rectWidth/2], ...
             [means(k), means(k)], ...
             'r-', 'LineWidth', 2.5);

        % Dummy patch handle for legend; do not pass rectangle directly.
        h_leg(ii) = patch(NaN, NaN, cmap(k,:), ...
            'EdgeColor', cmap(k,:));
    end

    h_mean = plot(NaN, NaN, 'r-', 'LineWidth', 2.5);

    xlim([0.5 - xPad, numel(idx) + 0.5 + xPad]);

    ymax = max(upper(idx));
    ymin = min(lower(idx));

    if isfinite(ymax) && isfinite(ymin) && ymax > ymin
        pad = 0.10 * (ymax - ymin);
        ylim([max(0, ymin - pad), ymax + pad]);
    elseif isfinite(ymax) && ymax > 0
        ylim([0, 1.10*ymax]);
    else
        ylim([0, 1]);
    end

    set(gca, ...
        'XTick', 1:numel(idx), ...
        'XTickLabel', paramLabels(idx), ...
        'TickLabelInterpreter','latex', ...
        'FontSize', FS, ...
        'LineWidth', 1.5);

    xlabel(groupXLabels{p}, 'FontSize', FS, 'Interpreter','latex');
    ylabel('Parameter values', 'FontSize', FS, 'Interpreter','latex');

    legend_labels = cell(1,numel(idx));
    for ii = 1:numel(idx)
        legend_labels{ii} = sprintf('%s (95\\%% CI)', paramLabels{idx(ii)});
    end

    % Same legend setup for all CI panels.
    % For Mnc, use northwest so the legend stays inside the subplot
    % without manually changing Position.
    if p == 4
        legendLocation = 'northwest';
    else
        legendLocation = 'best';
    end

    lgd = legend([h_leg h_mean], [legend_labels {'Mean'}], ...
        'Location', legendLocation, ...
        'Interpreter','latex', ...
        'FontSize', max(FS-4, 12), ...
        'NumColumns', 1, ...
        'Box','off');

    set(lgd,'Color','none');
end
end

function plot_pairwise(samples, best, labels, FS)
n = size(samples,2);
figure('Color','w','Position',[100 100 1300 1000]);

nRows = ceil(sqrt(n-1));
nCols = ceil((n-1)/nRows);

for i = 1:(n-1)
    subplot(nRows, nCols, i);
    hold on; box on; grid on;

    scatter(samples(:,i), samples(:,i+1), 15, 'b', 'filled', ...
        'MarkerFaceAlpha', 0.25);

    plot(best(i), best(i+1), 'r*', ...
        'MarkerSize', 9, 'LineWidth', 1.5);

    xlabel(labels{i}, ...
        'Interpreter','latex', ...
        'FontSize',FS-2);

    ylabel(labels{i+1}, ...
        'Interpreter','latex', ...
        'FontSize',FS-2);

    set(gca, ...
        'FontSize',FS-3, ...
        'LineWidth',1.2, ...
        'TickLabelInterpreter','latex');
end
end

