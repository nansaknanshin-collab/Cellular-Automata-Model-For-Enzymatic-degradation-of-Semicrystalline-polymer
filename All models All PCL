        "WL_fitted_percent": 100.0 * pred["wl"],
        "time_Xc_h": data["t_xc"],
        "Xc_observed_percent": 100.0 * data["xc_obs"],
        "Xc_fitted_percent": 100.0 * pred["xc"],
    })

    summary_path = os.path.join(
        OUTPUT_DIR, f"{SELECTED_POLYMER}_{model_label}_AIC_AICc_BIC_{timestamp}.csv"
    )
    param_path = os.path.join(
        OUTPUT_DIR, f"{SELECTED_POLYMER}_{model_label}_parameters_{timestamp}.csv"
    )
