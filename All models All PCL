def read_curve_data(workbook_path):
    """Read the exact fitted values exported by an embedded calibration."""
    data = pd.read_excel(workbook_path, sheet_name="curve_data")

    missing = [
        column for column in REQUIRED_COLUMNS
        if column not in data.columns
    ]

    if missing:
        raise ValueError(
            f"\nMissing columns in:\n{workbook_path}\n{missing}"
        )

    return data


def smooth_saved_curve(time_values, output_values, number_of_points=300):
    """
    Draw a shape-preserving smooth visual line through saved fitted values.

    This is applied only after calibration for presentation. It does not
    change or rerun any individual CA/PDE prediction.
    """
    curve = pd.DataFrame(
        {
            "time": pd.to_numeric(time_values, errors="coerce"),
            "value": pd.to_numeric(output_values, errors="coerce"),
        }
    ).dropna()

    curve = curve.sort_values("time").drop_duplicates(subset="time")

    x = curve["time"].to_numpy(dtype=float)
    y = curve["value"].to_numpy(dtype=float)

    if len(x) < 2:
        raise ValueError("At least two fitted points are required.")

    x_smooth = np.linspace(x.min(), x.max(), number_of_points)

    if len(x) == 2:
        y_smooth = np.interp(x_smooth, x, y)
    else:
        y_smooth = PchipInterpolator(x, y)(x_smooth)

    return x_smooth, y_smooth


def create_one_comparison_plot(
    grade,
    model_curves,
    time_column,
    fitted_column,
    observed_column,
    y_label,
    data_format,
    file_stem,
):
    """
    Create one separate figure using the settings of the earlier plots:
        figsize=(8, 5.5)
        model line width=5
        data marker size=10
        label font=18
        tick font=16
        grid alpha=0.30
        legend font=12, inside plot
    """
    fig, ax = plt.subplots(figsize=(8, 5.5))

    for model_name in MODEL_ORDER:
        curve_df = model_curves[model_name]
        t_smooth, y_smooth = smooth_saved_curve(
            curve_df[time_column],
            curve_df[fitted_column],
        )

        ax.plot(
            t_smooth,
            y_smooth,
            color=MODEL_COLOURS[model_name],
            linestyle="-",
            lw=5,
            label=model_name,
            zorder=2,
        )

    experimental = model_curves["No-amorphisation model"]

    ax.plot(
        experimental[time_column],
        experimental[observed_column],
        data_format,
        ms=10,
        label=f"{grade} Data",
        zorder=5,
    )

    ax.set_xlabel("Time (h)", fontsize=18)
    ax.set_ylabel(y_label, fontsize=18)
    ax.tick_params(axis="both", labelsize=16)
    ax.xaxis.set_major_locator(MaxNLocator(integer=True))
    ax.yaxis.set_major_locator(MaxNLocator(integer=True))
    ax.grid(alpha=0.30)
    ax.legend(fontsize=12, frameon=True, loc="best")

    plt.tight_layout()

    png_path = MASTER_OUTPUT_DIR / f"{file_stem}.png"
    pdf_path = MASTER_OUTPUT_DIR / f"{file_stem}.pdf"

    plt.savefig(png_path, dpi=600, bbox_inches="tight")
    plt.savefig(pdf_path, bbox_inches="tight")

    if SHOW_FINAL_COMPARISON_FIGURES:
        plt.show()

    plt.close(fig)

    print(f"Comparison PNG: {png_path}")
    print(f"Comparison PDF: {pdf_path}")


