def recalc_Mn_from_Nk_cell(Nk_cell):
    k_vals = np.arange(Nk_cell.size, dtype=float)
    total_units = np.sum(k_vals * Nk_cell)
    total_chains = np.sum(Nk_cell)

    if total_chains <= 0 or total_units <= 0:
        return 0.0

    return M0_REPEAT * total_units / total_chains


def perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng):
    Nk_cell = Nk[j, i, :]
    available = np.where(Nk_cell > 0)[0]
    available = available[available >= 2]

    if available.size == 0:
        return False

    weights = Nk_cell[available].astype(float)
    weights /= np.sum(weights)

    k_old = int(rng.choice(available, p=weights))
    r = int(rng.integers(1, k_old))

    Nk[j, i, k_old] -= 1
    Nk[j, i, r] += 1
    Nk[j, i, k_old - r] += 1

    Mn_field[j, i] = recalc_Mn_from_Nk_cell(Nk[j, i, :])
    return True


def update_Mn_after_scission_only(Nk, Mn_field, j, i):
    Mn_field[j, i] = recalc_Mn_from_Nk_cell(Nk[j, i, :])
    return None


# ============================================================
# 5) VON NEUMANN ENZYME NEIGHBOURHOOD FOR EROSION
# ============================================================
def von_neumann_enzyme_sum(E_field):
    Esum = np.zeros_like(E_field, dtype=float)

    Esum[1:, :] += E_field[:-1, :]
    Esum[:-1, :] += E_field[1:, :]
    Esum[:, 1:] += E_field[:, :-1]
    Esum[:, :-1] += E_field[:, 1:]

    Esum[0, :] += E_BATH
    Esum[-1, :] += E_BATH
    Esum[:, 0] += E_BATH
    Esum[:, -1] += E_BATH

    return Esum


def boundary_contact_mask(shape):
    ny, nx = shape
    mask = np.zeros((ny, nx), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    mask[:, -1] = True
    return mask


def von_neumann_degraded_count(phase):
    """Number of degraded (S_DEG) von Neumann neighbours for every cell."""
    deg = (phase == S_DEG).astype(float)
    count = np.zeros_like(deg, dtype=float)
    count[1:, :] += deg[:-1, :]
    count[:-1, :] += deg[1:, :]
    count[:, 1:] += deg[:, :-1]
    count[:, :-1] += deg[:, 1:]
    return count


def update_enzyme_inhibition_from_degraded_neighbours(
    phase, E_field, E_dead_field, k_inh, rng, dt
):
    """
    Locally deactivate a finite enzyme quantum when an internal cell has at
    least one degraded von Neumann neighbour. The inhibition probability is
    P_inh = 1 - exp[-k_inh (n_deg/4) dt]. E_dead_field is cumulative and
    retained for diagnostics; only E_field diffuses and drives reactions.
    """
    deg_count = von_neumann_degraded_count(phase)
    phi_deg = deg_count / 4.0
    dE_quantum = E_BATH / max(E_field.size // 100, 1)

    internal = np.ones_like(E_field, dtype=bool)
    internal[0, :] = False
    internal[-1, :] = False
    internal[:, 0] = False
    internal[:, -1] = False

    eligible = (
        internal
        & (E_field > ENZYME_NEIGHBOUR_THRESHOLD)
        & (deg_count >= 1.0)
    )

    P_inh = 1.0 - np.exp(-k_inh * phi_deg * dt)
    P_inh = np.clip(P_inh, 0.0, 1.0)

    inhibit = eligible & (rng.random(E_field.shape) < P_inh)
    inhibited_amount = np.minimum(E_field[inhibit], dE_quantum)

    E_field[inhibit] -= inhibited_amount
    E_dead_field[inhibit] += inhibited_amount
    np.clip(E_field, 0.0, None, out=E_field)


def update_voids_from_Mnc_and_von_neumann_enzyme(
    phase, Mn_field, Nk, deg_origin, mass_field, Mnc, E_field,
    k_det, beta_phi, rng, dt
):
    E_neigh_sum = von_neumann_enzyme_sum(E_field)
    has_E_neigh = E_neigh_sum > ENZYME_NEIGHBOUR_THRESHOLD
    boundary_contact = boundary_contact_mask(phase.shape)

    eligible = (
        (phase == S_DEG)
        & (boundary_contact | (Mn_field <= Mnc))
        & has_E_neigh
    )

    phi = compute_porosity_field(phase, window=PHI_WINDOW)
    k_det_eff = k_det * (1.0 + beta_phi * phi)

    E_neigh_mean = E_neigh_sum / 4.0
    P_void = 1.0 - np.exp(-k_det_eff * E_neigh_mean * dt)
    P_void = np.clip(P_void, 0.0, 1.0)

    erode = eligible & (rng.random(phase.shape) < P_void)

    phase[erode] = S_VOID
    Mn_field[erode] = 0.0
    mass_field[erode] = 0.0
    Nk[erode, :] = 0
    deg_origin[erode] = ORIGIN_NONE


# ============================================================
# 6) CA REACTION STEP
# ============================================================
def reaction_step(
    phase, bound, E_field, E_dead_field, Mn_field, mass_field, Nk,
    deg_origin, params, beta_phi, rng, dt
):
    # params order:
    # [k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det, k_inh]
    k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det, k_inh = params

    ny, nx = phase.shape
    phase_old = phase.copy()
    bound_old = bound.copy()
    E_old = E_field.copy()
    origin_old = deg_origin.copy()

    dE_quantum = E_BATH / max(ny * nx // 100, 1)

    U1 = rng.random((ny, nx))
    U2 = rng.random((ny, nx))

    for j in range(ny):
        for i in range(nx):
            s = phase_old[j, i]
            b = bound_old[j, i]
            E_loc = E_old[j, i]

            if s == S_VOID:
                continue

            u1 = U1[j, i]
            u2 = U2[j, i]

            if s == S_DEG:
                origin = origin_old[j, i]
                if origin == ORIGIN_C:
                    rate = k_deg_C * E_loc
                elif origin == ORIGIN_A:
                    rate = k_deg_A * E_loc
                else:
                    rate = 0.0

                P = 1.0 - np.exp(-rate * dt)
                if u1 < P:
                    perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng)
                    update_Mn_after_scission_only(Nk, Mn_field, j, i)
                continue

            if s == S_CRYST:
                if not b:
                    rate = k1 * E_loc
                    P = 1.0 - np.exp(-rate * dt)
                    if u1 < P and E_loc > dE_quantum:
                        bound[j, i] = True
                        E_field[j, i] -= dE_quantum
                else:
                    rates = np.array([k_conv, k_deg_C], dtype=float)
                    r_tot = np.sum(rates)
                    if r_tot > 0.0:
                        P = 1.0 - np.exp(-r_tot * dt)
                        if u1 < P:
                            if u2 < (k_conv / r_tot):
                                phase[j, i] = S_AMORPH
                            else:
                                phase[j, i] = S_DEG
                                deg_origin[j, i] = ORIGIN_C
                                perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng)
                                update_Mn_after_scission_only(Nk, Mn_field, j, i)
                            bound[j, i] = False
                            E_field[j, i] += dE_quantum
                continue

            if s == S_AMORPH:
                if not b:
                    rate = k3 * E_loc
                    P = 1.0 - np.exp(-rate * dt)
                    if u1 < P and E_loc > dE_quantum:
                        bound[j, i] = True
                        E_field[j, i] -= dE_quantum
                else:
                    rate = k_deg_A
                    P = 1.0 - np.exp(-rate * dt)
                    if u1 < P:
                        phase[j, i] = S_DEG
                        deg_origin[j, i] = ORIGIN_A
                        perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng)
                        update_Mn_after_scission_only(Nk, Mn_field, j, i)
                        bound[j, i] = False
                        E_field[j, i] += dE_quantum
                continue

    # Preserves the ordering in the supplied inhibition model: erosion first,
    # then enzyme inhibition calculated from the post-erosion phase field.
    update_voids_from_Mnc_and_von_neumann_enzyme(
        phase=phase, Mn_field=Mn_field, Nk=Nk, deg_origin=deg_origin,
        mass_field=mass_field, Mnc=Mnc, E_field=E_field, k_det=k_det,
        beta_phi=beta_phi, rng=rng, dt=dt
    )

    update_enzyme_inhibition_from_degraded_neighbours(
        phase=phase, E_field=E_field, E_dead_field=E_dead_field,
        k_inh=k_inh, rng=rng, dt=dt
    )

    E_field[0, :] = E_BATH
    E_field[-1, :] = E_BATH
    E_field[:, 0] = E_BATH
    E_field[:, -1] = E_BATH
    np.clip(E_field, 0.0, None, out=E_field)


# ============================================================
# 7) HYBRID CA/PDE SIMULATION DRIVER FOR ONE POLYMER
# ============================================================
def run_hybrid_one_polymer(
    params_kinetic, D_E0, alpha, beta_phi, MW0, chi, t_end, seed,
    record_times=None, PDI=None, verbose_init=False
):
    rng = np.random.default_rng(seed)
    ny, nx = ROWS, COLS
    target_mean_N = MW0 / M0_REPEAT

    if PDI is None:
        PDI = PDI_BY_GRADE[SELECTED_POLYMER]

    N0_per_cell = sample_initial_chain_lengths(
        rng, ny, nx, target_mean_N, PDI, N0_CAP_MULTIPLE
    )

    M_MAX = int(N0_per_cell.max())
    Nk = np.zeros((ny, nx, M_MAX + 1), dtype=np.int16)
    js, is_ = np.meshgrid(np.arange(ny), np.arange(nx), indexing="ij")
    Nk[js, is_, N0_per_cell] = 1

    Mn_field = M0_REPEAT * N0_per_cell.astype(float)
    mass_field = N0_per_cell.astype(float).copy()
    total_initial_units = float(np.sum(N0_per_cell))

    if verbose_init:
        realised_mean_N = N0_per_cell.mean()
        realised_PDI = float(np.exp(np.var(np.log(N0_per_cell.astype(float)))))
        print(f"  PDI init: target Mn = {MW0:.0f}, realised Mn = {M0_REPEAT * realised_mean_N:.0f}")
        print(f"  PDI init: target PDI = {PDI:.3f}, realised PDI = {realised_PDI:.3f}")
        print(f"  PDI init: M_MAX = {int(N0_per_cell.max())}, min N = {int(N0_per_cell.min())}")

    phase = rng.choice(
        [S_AMORPH, S_CRYST], size=(ny, nx), p=[1.0 - chi, chi]
    ).astype(int)
    bound = np.zeros((ny, nx), dtype=bool)
    deg_origin = np.full((ny, nx), ORIGIN_NONE, dtype=int)

    E_field = np.zeros((ny, nx), dtype=float)
    E_dead_field = np.zeros((ny, nx), dtype=float)
    E_field[0, :] = E_BATH
    E_field[-1, :] = E_BATH
    E_field[:, 0] = E_BATH
    E_field[:, -1] = E_BATH

    if record_times is None:
        record_times = np.linspace(0.0, t_end, 51)
    record_times = np.asarray(record_times, dtype=float)

    t_record, wl_record, xc_record, mn_record, deadE_record = [], [], [], [], []

    def metrics():
        massC = float(np.sum(mass_field[phase == S_CRYST]))
        massA = float(np.sum(mass_field[phase == S_AMORPH]))
        massD = float(np.sum(mass_field[phase == S_DEG]))
        total_remaining = massC + massA + massD

        wl = float(np.clip(1.0 - total_remaining / total_initial_units, 0.0, 1.0))
        denom_xc = massC + massA + massD
        xc = float(np.clip(massC / denom_xc if denom_xc > 0.0 else 0.0, 0.0, 1.0))
        mn_global = recalc_Mn_from_Nk_cell(np.sum(Nk, axis=(0, 1)))
        deadE_total = float(np.sum(E_dead_field))
        return wl, xc, mn_global, deadE_total

    t = 0.0
    wl0, xc0, mn0, deadE0 = metrics()
    t_record.append(0.0)
    wl_record.append(wl0)
    xc_record.append(xc0)
    mn_record.append(mn0)
    deadE_record.append(deadE0)
    next_record_idx = 1

    while t < t_end - 1e-12:
        E_field = diffuse_E(E_field, phase, D_E0, alpha, DT, DX)
        reaction_step(
            phase=phase, bound=bound, E_field=E_field,
            E_dead_field=E_dead_field, Mn_field=Mn_field,
            mass_field=mass_field, Nk=Nk, deg_origin=deg_origin,
            params=params_kinetic, beta_phi=beta_phi, rng=rng, dt=DT
        )
        t += DT

        while next_record_idx < len(record_times) and record_times[next_record_idx] <= t + 1e-12:
            wl, xc, mn_global, deadE_total = metrics()
            t_record.append(record_times[next_record_idx])
            wl_record.append(wl)
            xc_record.append(xc)
            mn_record.append(mn_global)
            deadE_record.append(deadE_total)
            next_record_idx += 1

    return (
        np.asarray(t_record), np.asarray(wl_record), np.asarray(xc_record),
        np.asarray(mn_record), np.asarray(deadE_record)
    )


# ============================================================
# 8) PARAMETER UNPACKING + ONE-POLYMER SIMULATION
# ============================================================
def unpack_theta(theta):
    """Unpack the 11-parameter vector into CA reaction and PDE parameters."""
    theta = np.asarray(theta, dtype=float).ravel()
    if theta.shape != THETA_LO.shape:
        raise ValueError(f"Expected {THETA_LO.size} parameters, got {theta.size}.")

    k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det, D_E0, alpha, beta_phi, k_inh = theta
    params_kinetic = (
        float(k1), float(k3), float(k_conv), float(k_deg_C),
        float(k_deg_A), float(Mnc), float(k_det), float(k_inh)
    )
    return params_kinetic, float(D_E0), float(alpha), float(beta_phi)


def simulate_polymer_predictions(poly_name, theta, seeds=SEEDS, record_times=None):
    data = POLYMER_DATA[poly_name]
    PDI = PDI_BY_GRADE[poly_name]

    params_kinetic, D_E0, alpha, beta_phi = unpack_theta(theta)

    if record_times is None:
        record_times = np.unique(np.concatenate([data["t_wl"], data["t_xc"]]))

    t_end = float(np.max(record_times))
    wl_runs, xc_runs, deadE_runs = [], [], []

    for sd in seeds:
        t_sim, wl_sim, xc_sim, _, deadE_sim = run_hybrid_one_polymer(
            params_kinetic=params_kinetic,
            D_E0=D_E0,
            alpha=alpha,
            beta_phi=beta_phi,
            MW0=data["MN0"],
            chi=data["X_FIXED"],
            t_end=t_end,
            seed=int(sd),
            record_times=record_times,
            PDI=PDI,
        )

        wl_runs.append(np.interp(data["t_wl"], t_sim, wl_sim))
        xc_runs.append(np.interp(data["t_xc"], t_sim, xc_sim))
        deadE_runs.append(np.interp(record_times, t_sim, deadE_sim))

    return {
        "wl": np.mean(np.asarray(wl_runs), axis=0),
        "xc": np.mean(np.asarray(xc_runs), axis=0),
        "deadE": np.mean(np.asarray(deadE_runs), axis=0),
        "record_times": record_times,
    }


# ============================================================
# 9) ORDINARY JOINT LEAST-SQUARES COST
# ============================================================
def joint_ls_cost(theta):
    """Ordinary WL + Xc least-squares objective for the inhibition model.

    The shared ten parameters follow the PCL6300 direct physical-coordinate
    reference exactly. k_inh is retained as the model-specific eleventh term.
    """
    theta = np.asarray(theta, dtype=float).ravel()

    if theta.shape != THETA_LO.shape or not np.all(np.isfinite(theta)):
        return 1e12
    if np.any(theta <= 0.0):
        return 1e12

    params_kinetic, D_E0, alpha, beta_phi = unpack_theta(theta)
    k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det, k_inh = params_kinetic

    # Same direct constraints as the PCL6300 10-parameter reference.
    if k_deg_A <= k_deg_C:
        return 1e12
    if k3 <= k1:
        return 1e12
    if not (0.0 <= Mnc <= 25000.0):
        return 1e12
    if not (1.0 <= alpha <= 100.0):
        return 1e12
    if not (1.0 <= beta_phi <= 100.0):
        return 1e12

    # Inhibition-only parameter bounds.
    if not (1e-6 <= k_inh <= 20.0):
        return 1e12

    residuals = []
    try:
        for poly_name, data in POLYMER_DATA.items():
            pred = simulate_polymer_predictions(poly_name, theta)
            residuals.extend(pred["wl"] - data["wl_obs"])
            residuals.extend(pred["xc"] - data["xc_obs"])
        residuals = np.asarray(residuals, dtype=float)
        cost = np.sum(residuals**2)
    except Exception:
        return 1e12

    return float(cost) if np.isfinite(cost) else 1e12


def pso_objective(swarm):
    """Direct physical-coordinate PSO wrapper, matching the PCL6300 reference."""
    return np.array([joint_ls_cost(theta) for theta in swarm], dtype=float)


# ============================================================
# 10) PSO + SLSQP CALIBRATION OF ALL ELEVEN PARAMETERS
# ============================================================
def calibrate_pso_ls_all_parameters(n_particles=25, iters=15, local_refine=True):
    """Calibrate 11 parameters in physical units, as in the PCL6300 code."""
    np.random.seed(SEED)

    optimizer = GlobalBestPSO(
        n_particles=n_particles,
        dimensions=THETA_LO.size,
        bounds=(THETA_LO, THETA_HI),
        options={"c1": 1.7, "c2": 1.7, "w": 0.6}
    )

    best_cost, best_theta = optimizer.optimize(
        pso_objective,
        iters=iters,
        verbose=True
    )

    theta_final = np.asarray(best_theta, dtype=float)
    final_cost = float(best_cost)

    if local_refine:
        res = minimize(
            joint_ls_cost,
            theta_final,
            method="SLSQP",
            bounds=list(zip(THETA_LO, THETA_HI)),
            options={
                "maxiter": 120,
                "ftol": 1e-8,
                "disp": True
            }
        )
        if np.isfinite(res.fun):
            theta_final = np.asarray(res.x, dtype=float)
            final_cost = float(res.fun)

    print("\n================ FINAL PARAMETERS ================")
    for name, value, lower, upper in zip(PARAMETER_NAMES, theta_final, THETA_LO, THETA_HI):
        units = " g/mol" if name == "Mnc" else ""
        print(f"{name:22s} = {value:.6e}{units}   [{lower:.6e}, {upper:.6e}]")

    print(f"{'PHI_WINDOW':22s} = {PHI_WINDOW:d}")
    print(f"{'PDI':22s} = {PDI_BY_GRADE[SELECTED_POLYMER]:.3f}  (Ma et al. 2020, input)")
    print(f"{'N0_CAP_MULTIPLE':22s} = {N0_CAP_MULTIPLE:.2f}")
    print(f"Final ordinary joint least-squares cost = {final_cost:.6e}")

    return theta_final, final_cost

# ============================================================
# 12) FIT QUALITY + AIC/AICc/BIC MODEL SELECTION
# ============================================================
def r2_score(y_true, y_pred):
    y_true = np.asarray(y_true, float)
    y_pred = np.asarray(y_pred, float)
    ss_res = np.sum((y_true - y_pred) ** 2)
    ss_tot = np.sum((y_true - np.mean(y_true)) ** 2)
    return np.nan if ss_tot == 0 else 1.0 - ss_res / ss_tot


def rmse_pp(y_true, y_pred):
    y_true = np.asarray(y_true, float)
    y_pred = np.asarray(y_pred, float)
    return 100.0 * float(np.sqrt(np.mean((y_true - y_pred) ** 2)))


def mean_bias_pp(y_true, y_pred):
    y_true = np.asarray(y_true, float)
    y_pred = np.asarray(y_pred, float)
    return 100.0 * float(np.mean(y_pred - y_true))


def compute_information_criteria(rss, k, n):
    rss = float(rss)
    k = int(k)
    n = int(n)

    if rss <= 0.0:
        rss = 1e-300

    aic = n * np.log(rss / n) + 2.0 * k
    bic = n * np.log(rss / n) + k * np.log(n)

    if n - k - 1 > 0:
        aicc = aic + (2.0 * k * (k + 1.0)) / (n - k - 1.0)
    else:
        aicc = np.nan

    return aic, aicc, bic


def count_observations():
    n = 0
    for _, data in POLYMER_DATA.items():
        n += len(data["wl_obs"])
        n += len(data["xc_obs"])
    return int(n)


def get_parameter_names(k):
    if k == THETA_LO.size:
        return PARAMETER_NAMES.copy()
    return [f"theta_{i+1}" for i in range(k)]


def get_model_label():
    return "grade_specific_11param_amorphisation_enzyme_inhibition_PCL6500ReferenceBounds"


def save_model_outputs(theta_opt, final_cost):
    data = POLYMER_DATA[SELECTED_POLYMER]
    pred = simulate_polymer_predictions(SELECTED_POLYMER, theta_opt)

    r2_wl = r2_score(data["wl_obs"], pred["wl"])
    r2_xc = r2_score(data["xc_obs"], pred["xc"])

    rmse_wl = rmse_pp(data["wl_obs"], pred["wl"])
    rmse_xc = rmse_pp(data["xc_obs"], pred["xc"])

    bias_wl = mean_bias_pp(data["wl_obs"], pred["wl"])
    bias_xc = mean_bias_pp(data["xc_obs"], pred["xc"])

    n = count_observations()
    k = THETA_LO.size  # All eleven parameters are fitted.
    rss = float(final_cost)
    aic, aicc, bic = compute_information_criteria(rss=rss, k=k, n=n)

    model_label = get_model_label()
    names = get_parameter_names(THETA_LO.size)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

    print(f"\n================ {SELECTED_POLYMER} FIT QUALITY ================")
    print(f"Model type       = {model_label}")
    print(f"R² WL            = {r2_wl:.6f}")
    print(f"R² Xc            = {r2_xc:.6f}")
    print(f"RMSE WL          = {rmse_wl:.6f} percentage points")
    print(f"RMSE Xc          = {rmse_xc:.6f} percentage points")
    print(f"Bias WL          = {bias_wl:+.6f} percentage points")
    print(f"Bias Xc          = {bias_xc:+.6f} percentage points")
    print(f"RSS/final cost   = {rss:.10e}")

    print("\n================ AIC / AICc / BIC ================")
    print(f"Number of observations, n       = {n}")
    print(f"Number of fitted parameters, k  = {k}")
    print(f"AIC                             = {aic:.6f}")
