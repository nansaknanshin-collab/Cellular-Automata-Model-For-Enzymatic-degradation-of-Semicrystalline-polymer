def write_exact_source_copies():
    """Write visible one-to-one copies of the nine embedded source scripts."""
    if not WRITE_EXACT_SOURCE_COPIES:
        return

    EXTRACTED_SOURCE_DIR.mkdir(parents=True, exist_ok=True)
    manifest_rows = []

    for item in EMBEDDED_SCRIPTS:
        safe_model_name = (
            item["model"]
            .lower()
            .replace("-", "_")
            .replace(" ", "_")
        )
        output_path = EXTRACTED_SOURCE_DIR / (
            f"{item['order']:02d}_{item['grade']}_{safe_model_name}.py"
        )
        # Write LF line endings explicitly. Without this, Windows may convert
        # embedded source newlines to CRLF and change a byte-level SHA-256
        # checksum even though the Python code is identical.
        with output_path.open(
            "w",
            encoding="utf-8",
            newline="\n",
        ) as source_file:
            source_file.write(item["source"])

        digest = hashlib.sha256(
            output_path.read_bytes()
        ).hexdigest()

        if digest != item["sha256"]:
            raise RuntimeError(
                f"Integrity check failed for {output_path.name}. "
                "The embedded source text was not altered; this check only "
                "verifies the byte-for-byte exported copy."
            )

        manifest_rows.append(
            {
                "run_order": item["order"],
                "PCL_grade": item["grade"],
                "model": item["model"],
                "original_uploaded_source_name": item["source_name"],
                "SHA256": digest,
                "extracted_source_file": str(output_path),
            }
        )

    manifest = pd.DataFrame(manifest_rows)
    manifest.to_csv(
        MASTER_OUTPUT_DIR / "embedded_source_manifest.csv",
        index=False,
    )

    print("\nExact source copies written to:")
    print(EXTRACTED_SOURCE_DIR)


def newest_curve_workbook(output_dir, grade):
    """Find the most recent curve-and-AIC/BIC workbook for one original run."""
    candidates = list(
        output_dir.glob(f"{grade}_*curve_and_AIC_BIC_*.xlsx")
    )

    if not candidates:
        return None

    return max(candidates, key=lambda path: path.stat().st_mtime)


def execute_exact_embedded_script(item):
    """
    Run a literal embedded individual script in its own namespace.

    The source is executed as __main__, so its original standalone block
    runs exactly as it would when opened separately in Spyder.
    """
    label = f"{item['grade']} -- {item['model']}"

    print("\n" + "=" * 78)
    print(f"RUN {item['order']}/9: {label}")
    print("=" * 78)
    print(f"Embedded source: {item['source_name']}")
    print(f"SHA256: {item['sha256']}")

    source_filename = (
        f"<embedded_{item['order']:02d}_"
        f"{item['grade']}_{item['model'].replace(' ', '_')}.py>"
    )

    namespace = {
        "__name__": "__main__",
        "__file__": source_filename,
    }

    original_show = plt.show

    if not SHOW_INDIVIDUAL_FIT_FIGURES:
        plt.show = lambda *args, **kwargs: None

    try:
        exec(
            compile(item["source"], source_filename, "exec"),
            namespace,
            namespace,
        )
    finally:
        plt.show = original_show

    output_dir = ORIGINAL_OUTPUT_DIRS[
        (item["grade"], item["model"])
    ]

    workbook = newest_curve_workbook(
        output_dir=output_dir,
        grade=item["grade"],
    )

    if workbook is None:
        raise FileNotFoundError(
            "\nThe embedded code completed but its expected Excel workbook "
            f"was not found for {label}.\nExpected folder:\n{output_dir}"
        )

    print(f"\nSaved curve-data workbook detected:\n{workbook}")
    return workbook


