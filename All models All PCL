# ============================================================
# 2) POROSITY-DEPENDENT DIFFUSIVITY
# ============================================================
def compute_porosity_field(phase, window):
    void_only = (phase == S_VOID).astype(float)
    ny, nx = phase.shape
    phi = np.zeros_like(void_only, dtype=float)

    pad = max(int(window), 1)
    padded_void = np.pad(void_only, pad_width=pad, mode="constant", constant_values=1.0)
    w = 2 * pad + 1

    for dj in range(-pad, pad + 1):
        for di in range(-pad, pad + 1):
            phi += padded_void[pad + dj:pad + dj + ny, pad + di:pad + di + nx]

    phi /= float(w * w)
    return phi


def effective_diffusivity(phi, D_E0, alpha):
    return D_E0 * (1.0 + alpha * phi)


# ============================================================
# 3) SAME-GRID FOUR-SIDED DIFFUSION PDE
# ============================================================
def build_diffusion_matrix(D_field, dt, dx, bath_value):
    ny, nx = D_field.shape
    n_solve_rows = ny - 2
    n_solve_cols = nx - 2

    if n_solve_rows <= 0 or n_solve_cols <= 0:
        raise ValueError("ROWS and COLS must both be at least 3.")

    N = n_solve_rows * n_solve_cols

    def idx(j, i):
        return (j - 1) * n_solve_cols + (i - 1)

    rows, cols, vals = [], [], []
    rhs_extra = np.zeros(N)

    for j in range(1, ny - 1):
        for i in range(1, nx - 1):
            k = idx(j, i)
            diag_val = 1.0

            for dj, di in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                jj, ii = j + dj, i + di
                D_face = 0.5 * (D_field[j, i] + D_field[jj, ii])
                coef = dt * D_face / dx**2

                if jj == 0 or jj == ny - 1 or ii == 0 or ii == nx - 1:
                    rhs_extra[k] += coef * bath_value
                else:
                    rows.append(k)
                    cols.append(idx(jj, ii))
                    vals.append(-coef)

                diag_val += coef

            rows.append(k)
            cols.append(k)
            vals.append(diag_val)

    A = csr_matrix((vals, (rows, cols)), shape=(N, N))
    return A, rhs_extra


def diffuse_field(field, phase, D_E0, alpha, dt, dx, bath_value):
    ny, nx = field.shape
    phi = compute_porosity_field(phase, window=PHI_WINDOW)
    D_field = effective_diffusivity(phi, D_E0, alpha)

    A, rhs_extra = build_diffusion_matrix(D_field, dt, dx, bath_value=bath_value)
    rhs = field[1:-1, 1:-1].flatten() + rhs_extra
    internal_new = spsolve(A, rhs).reshape(ny - 2, nx - 2)

    out = field.copy()
    out[0, :] = bath_value
    out[-1, :] = bath_value
    out[:, 0] = bath_value
    out[:, -1] = bath_value
    out[1:-1, 1:-1] = internal_new
    np.clip(out, 0.0, None, out=out)
    return out


def diffuse_E(E_field, phase, D_E0, alpha, dt, dx):
    return diffuse_field(E_field, phase, D_E0, alpha, dt, dx, E_BATH)


# ============================================================
# 3a) POLYDISPERSE INITIAL CHAIN LENGTH SAMPLING
# ============================================================
def sample_initial_chain_lengths(rng, ny, nx, target_mean_N, PDI, cap_multiple):
    sigma_ln = np.sqrt(np.log(PDI))
    mu_ln = np.log(target_mean_N) - 0.5 * sigma_ln**2
    N_samples = rng.lognormal(mean=mu_ln, sigma=sigma_ln, size=(ny, nx))
    N_cap = cap_multiple * target_mean_N
    return np.clip(np.round(N_samples), 2, N_cap).astype(int)


# ============================================================
# 4) MOLECULAR WEIGHT + CHAIN TRACKING
# ============================================================
def recalc_Mn_from_Nk_cell(Nk_cell):
    k_vals = np.arange(Nk_cell.size, dtype=float)
    total_units = np.sum(k_vals * Nk_cell)
    total_chains = np.sum(Nk_cell)

    if total_chains <= 0 or total_units <= 0:
        return 0.0

    return M0_REPEAT * total_units / total_chains


def perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng):
    Nk_cell = Nk[j, i, :]
    available = np.where(Nk_cell > 0)[0]
    available = available[available >= 2]

    if available.size == 0:
        return False

    weights = Nk_cell[available].astype(float)
    weights /= np.sum(weights)

    k_old = int(rng.choice(available, p=weights))
    r = int(rng.integers(1, k_old))

    Nk[j, i, k_old] -= 1
    Nk[j, i, r] += 1
    Nk[j, i, k_old - r] += 1

    Mn_field[j, i] = recalc_Mn_from_Nk_cell(Nk[j, i, :])
    return True


def update_Mn_after_scission_only(Nk, Mn_field, j, i):
    Mn_field[j, i] = recalc_Mn_from_Nk_cell(Nk[j, i, :])
    return None


# ============================================================
# 5) VON NEUMANN ENZYME NEIGHBOURHOOD FOR EROSION
# ============================================================
def von_neumann_enzyme_sum(E_field):
    Esum = np.zeros_like(E_field, dtype=float)

    Esum[1:, :] += E_field[:-1, :]
    Esum[:-1, :] += E_field[1:, :]
    Esum[:, 1:] += E_field[:, :-1]
    Esum[:, :-1] += E_field[:, 1:]

    Esum[0, :] += E_BATH
    Esum[-1, :] += E_BATH
    Esum[:, 0] += E_BATH
    Esum[:, -1] += E_BATH

    return Esum


def boundary_contact_mask(shape):
    ny, nx = shape
    mask = np.zeros((ny, nx), dtype=bool)
    mask[0, :] = True
    mask[-1, :] = True
    mask[:, 0] = True
    mask[:, -1] = True
    return mask


def von_neumann_degraded_count(phase):
    """Number of degraded (S_DEG) von Neumann neighbours for every cell."""
    deg = (phase == S_DEG).astype(float)
    count = np.zeros_like(deg, dtype=float)
    count[1:, :] += deg[:-1, :]
    count[:-1, :] += deg[1:, :]
    count[:, 1:] += deg[:, :-1]
    count[:, :-1] += deg[:, 1:]
    return count


def update_enzyme_inhibition_from_degraded_neighbours(
    phase, E_field, E_dead_field, k_inh, rng, dt
):
    """
    Locally deactivate a finite enzyme quantum when an internal cell has at
    least one degraded von Neumann neighbour. The inhibition probability is
    P_inh = 1 - exp[-k_inh (n_deg/4) dt]. E_dead_field is cumulative and
    retained for diagnostics; only E_field diffuses and drives reactions.
    """
    deg_count = von_neumann_degraded_count(phase)
    phi_deg = deg_count / 4.0
    dE_quantum = E_BATH / max(E_field.size // 100, 1)

    internal = np.ones_like(E_field, dtype=bool)
    internal[0, :] = False
    internal[-1, :] = False
    internal[:, 0] = False
    internal[:, -1] = False

    eligible = (
        internal
        & (E_field > ENZYME_NEIGHBOUR_THRESHOLD)
        & (deg_count >= 1.0)
    )

    P_inh = 1.0 - np.exp(-k_inh * phi_deg * dt)
    P_inh = np.clip(P_inh, 0.0, 1.0)

    inhibit = eligible & (rng.random(E_field.shape) < P_inh)
    inhibited_amount = np.minimum(E_field[inhibit], dE_quantum)

    E_field[inhibit] -= inhibited_amount
    E_dead_field[inhibit] += inhibited_amount
    np.clip(E_field, 0.0, None, out=E_field)


def update_voids_from_Mnc_and_von_neumann_enzyme(
    phase, Mn_field, Nk, deg_origin, mass_field, Mnc, E_field,
    k_det, beta_phi, rng, dt
):
    E_neigh_sum = von_neumann_enzyme_sum(E_field)
    has_E_neigh = E_neigh_sum > ENZYME_NEIGHBOUR_THRESHOLD
    boundary_contact = boundary_contact_mask(phase.shape)

    eligible = (
        (phase == S_DEG)
        & (boundary_contact | (Mn_field <= Mnc))
        & has_E_neigh
    )

    phi = compute_porosity_field(phase, window=PHI_WINDOW)
    k_det_eff = k_det * (1.0 + beta_phi * phi)

    E_neigh_mean = E_neigh_sum / 4.0
    P_void = 1.0 - np.exp(-k_det_eff * E_neigh_mean * dt)
    P_void = np.clip(P_void, 0.0, 1.0)

    erode = eligible & (rng.random(phase.shape) < P_void)

    phase[erode] = S_VOID
    Mn_field[erode] = 0.0
    mass_field[erode] = 0.0
    Nk[erode, :] = 0
    deg_origin[erode] = ORIGIN_NONE


# ============================================================
# 6) CA REACTION STEP
# ============================================================
def reaction_step(
    phase, bound, E_field, E_dead_field, Mn_field, mass_field, Nk,
    deg_origin, params, beta_phi, rng, dt
):
    # params order:
    # [k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det, k_inh]
    k1, k3, k_conv, k_deg_C, k_deg_A, Mnc, k_det, k_inh = params

    ny, nx = phase.shape
    phase_old = phase.copy()
    bound_old = bound.copy()
    E_old = E_field.copy()
    origin_old = deg_origin.copy()

    dE_quantum = E_BATH / max(ny * nx // 100, 1)

    U1 = rng.random((ny, nx))
    U2 = rng.random((ny, nx))

    for j in range(ny):
        for i in range(nx):
            s = phase_old[j, i]
            b = bound_old[j, i]
            E_loc = E_old[j, i]

            if s == S_VOID:
                continue

            u1 = U1[j, i]
            u2 = U2[j, i]

            if s == S_DEG:
                origin = origin_old[j, i]
                if origin == ORIGIN_C:
                    rate = k_deg_C * E_loc
                elif origin == ORIGIN_A:
                    rate = k_deg_A * E_loc
                else:
                    rate = 0.0

                P = 1.0 - np.exp(-rate * dt)
                if u1 < P:
                    perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng)
                    update_Mn_after_scission_only(Nk, Mn_field, j, i)
                continue

            if s == S_CRYST:
                if not b:
                    rate = k1 * E_loc
                    P = 1.0 - np.exp(-rate * dt)
                    if u1 < P and E_loc > dE_quantum:
                        bound[j, i] = True
                        E_field[j, i] -= dE_quantum
                else:
                    rates = np.array([k_conv, k_deg_C], dtype=float)
                    r_tot = np.sum(rates)
                    if r_tot > 0.0:
                        P = 1.0 - np.exp(-r_tot * dt)
                        if u1 < P:
                            if u2 < (k_conv / r_tot):
                                phase[j, i] = S_AMORPH
                            else:
                                phase[j, i] = S_DEG
                                deg_origin[j, i] = ORIGIN_C
                                perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng)
                                update_Mn_after_scission_only(Nk, Mn_field, j, i)
                            bound[j, i] = False
                            E_field[j, i] += dE_quantum
                continue

            if s == S_AMORPH:
                if not b:
                    rate = k3 * E_loc
                    P = 1.0 - np.exp(-rate * dt)
                    if u1 < P and E_loc > dE_quantum:
                        bound[j, i] = True
                        E_field[j, i] -= dE_quantum
                else:
                    rate = k_deg_A
                    P = 1.0 - np.exp(-rate * dt)
                    if u1 < P:
                        phase[j, i] = S_DEG
                        deg_origin[j, i] = ORIGIN_A
                        perform_chain_scission_full_Nk(Nk, Mn_field, j, i, rng)
                        update_Mn_after_scission_only(Nk, Mn_field, j, i)
                        bound[j, i] = False
                        E_field[j, i] += dE_quantum
                continue

    # Preserves the ordering in the supplied inhibition model: erosion first,
    # then enzyme inhibition calculated from the post-erosion phase field.
    update_voids_from_Mnc_and_von_neumann_enzyme(
        phase=phase, Mn_field=Mn_field, Nk=Nk, deg_origin=deg_origin,
        mass_field=mass_field, Mnc=Mnc, E_field=E_field, k_det=k_det,
        beta_phi=beta_phi, rng=rng, dt=dt
    )

    update_enzyme_inhibition_from_degraded_neighbours(
        phase=phase, E_field=E_field, E_dead_field=E_dead_field,
        k_inh=k_inh, rng=rng, dt=dt
    )

    E_field[0, :] = E_BATH
    E_field[-1, :] = E_BATH
    E_field[:, 0] = E_BATH
    E_field[:, -1] = E_BATH
    np.clip(E_field, 0.0, None, out=E_field)


